{
  "name": "Production Sentinel: API Failure Monitor & Incident Dispatcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "node-trigger-schedule",
      "name": "Schedule Heartbeat (Every 5m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.MONITOR_URL || 'http://localhost:8000/api/ai/workflow-monitor/workflows' }}",
        "options": {
          "timeout": 5000,
          "neverError": true,
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "node-http-probe",
      "name": "Probe Client API Endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.statusCode }}",
              "operation": "notEqual",
              "value2": 200
            }
          ]
        }
      },
      "id": "node-if-failed",
      "name": "If Status != 200",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🚨 **WORKFLOW OUTAGE ALERT**\n\n• **Target:** {{ $env.MONITOR_URL || 'API Endpoint' }}\n• **Status Code:** {{ $json.statusCode || 'UNKNOWN' }}\n• **Failure Details:** {{ $json.body?.error || $json.error || 'Health probe failed or timed out' }}\n• **Timestamp:** {{ $now.toISO() }}\n• **Status:** Alert dispatched to on-call engineer for investigation\n\n_Telemetry Sentinel_",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "node-telegram-dispatch",
      "name": "Dispatch Instant Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        940,
        280
      ]
    }
  ],
  "connections": {
    "Schedule Heartbeat (Every 5m)": {
      "main": [
        [
          {
            "node": "Probe Client API Endpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Probe Client API Endpoint": {
      "main": [
        [
          {
            "node": "If Status != 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Status != 200": {
      "main": [
        [
          {
            "node": "Dispatch Instant Telegram Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
