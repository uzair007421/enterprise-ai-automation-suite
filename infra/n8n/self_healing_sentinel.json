{
  "name": "Production Sentinel: API Failure Monitor & Instant Telegram Alert",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "node-trigger-schedule",
      "name": "Schedule Heartbeat (Every 5m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.yourdomain.com/v1/health",
        "options": {
          "timeout": 5000
        }
      },
      "id": "node-http-probe",
      "name": "Probe Client API Endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        480,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.statusCode }}",
              "operation": "notEqual",
              "value2": 200
            }
          ]
        }
      },
      "id": "node-if-failed",
      "name": "If Status != 200",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🚨 **CRITICAL WORKFLOW ALERT**\n\n• **Pipeline:** Client Shopify Webhook Fleet\n• **Error Code:** {{ $json.statusCode || 'GATEWAY_TIMEOUT' }}\n• **Failure Details:** {{ $json.error || 'Endpoint failed to respond within 5000ms' }}\n• **Timestamp:** {{ $now.toISO() }}\n• **Autonomous Action:** Triggered Exponential Jitter Backoff (Attempt 1/3)\n\n_Generated by Muhammad Uzair Telemetry Sentinel_",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "node-telegram-dispatch",
      "name": "Dispatch Instant Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        940,
        280
      ]
    }
  ],
  "connections": {
    "Schedule Heartbeat (Every 5m)": {
      "main": [
        [
          {
            "node": "Probe Client API Endpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Probe Client API Endpoint": {
      "main": [
        [
          {
            "node": "If Status != 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Status != 200": {
      "main": [
        [
          {
            "node": "Dispatch Instant Telegram Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
